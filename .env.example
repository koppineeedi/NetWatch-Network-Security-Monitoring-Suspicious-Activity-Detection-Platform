# ============================================================
# NetWatch - Enterprise Environment Configuration Template
# ============================================================
# Copy this file to .env and configure for your environment.
# All external cloud, threat intel, and SOAR driver variables are OPTIONAL.
# Missing optional credentials will default to status: NOT_CONFIGURED.

# ------------------------------------------------------------
# 1. CORE & DATABASE (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------
DATABASE_URL=sqlite:///./netwatch.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://netwatch_user:secure_password@localhost:5432/netwatch_db

# JWT Security Secret (CRITICAL: Change to strong random 64-char string in production!)
NETWATCH_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-2026
NETWATCH_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production CORS Allowed Origins (Comma-separated list, NO wildcard '*' with auth)
NETWATCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Admin Bootstrap Credentials (Used only during initialization script)
NETWATCH_ADMIN_USER=admin
NETWATCH_ADMIN_EMAIL=admin@netwatch.local
NETWATCH_ADMIN_PASSWORD=Admin123!

# ------------------------------------------------------------
# 2. LOG COLLECTORS (OPTIONAL)
# ------------------------------------------------------------
# Remote UDP/TCP Syslog Ingestion (Requires port 514 binding privileges)
NETWATCH_SYSLOG_ENABLED=false
NETWATCH_SYSLOG_HOST=0.0.0.0
NETWATCH_SYSLOG_UDP_PORT=514
NETWATCH_SYSLOG_TCP_PORT=514

# ------------------------------------------------------------
# 3. THREAT INTELLIGENCE PROVIDERS (OPTIONAL)
# ------------------------------------------------------------
# AbuseIPDB API Key (v2 API)
ABUSEIPDB_API_KEY=

# AlienVault OTX API Key (v1 API)
OTX_API_KEY=

# MISP Server Integration
MISP_URL=
MISP_API_KEY=

# Threat Intel Cache Expiration (minutes)
NETWATCH_TI_CACHE_MINUTES=60

# ------------------------------------------------------------
# 4. CLOUD LOG CONNECTORS (OPTIONAL)
# ------------------------------------------------------------
# AWS CloudTrail
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Azure Activity Logs
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# GCP Audit Logs
GCP_PROJECT_ID=
GCP_CREDENTIALS_JSON=

# ------------------------------------------------------------
# 5. UEBA & BEHAVIORAL ANALYTICS
# ------------------------------------------------------------
NETWATCH_UEBA_ENABLED=true
NETWATCH_UEBA_BASELINE_HOURS=168
NETWATCH_UEBA_MIN_EVENTS=20
NETWATCH_UEBA_REFRESH_MINUTES=60
NETWATCH_RISK_DECAY_HOURS=24
NETWATCH_ANOMALY_LOW=30
NETWATCH_ANOMALY_MEDIUM=60
NETWATCH_ANOMALY_HIGH=80
NETWATCH_ANOMALY_CRITICAL=90
NETWATCH_ANALYTICS_RETENTION_DAYS=90

# ------------------------------------------------------------
# 6. SIGMA RULE ENGINE
# ------------------------------------------------------------
NETWATCH_SIGMA_ENABLED=true
NETWATCH_SIGMA_SANDBOX_MAX_DAYS=7
NETWATCH_SIGMA_MAX_RULE_SIZE_MB=1
NETWATCH_SIGMA_MAX_CONCURRENT_TESTS=2
NETWATCH_SIGMA_REFRESH_SECONDS=60
NETWATCH_SIGMA_MAX_MATCHES=10000

# ------------------------------------------------------------
# 7. SOAR & AUTOMATED INCIDENT RESPONSE (OPTIONAL DRIVERS)
# ------------------------------------------------------------
# Global Dry-Run Safety Switch (Set 'true' to block all real OS manipulations)
NETWATCH_SOAR_DRY_RUN=false

# Maximum SOAR Actions per minute (Rate limit protection)
NETWATCH_SOAR_MAX_ACTIONS_PER_MINUTE=20

# Maximum Playbook Recursion Depth
NETWATCH_SOAR_MAX_PLAYBOOK_DEPTH=5

# Host Isolation Driver Configuration ('none', 'windows_netsh', 'agent')
NETWATCH_SOAR_AUTO_ISOLATION_ENABLED=false
NETWATCH_SOAR_HOST_ISOLATION_DRIVER=none

# Identity Provider (IAM) Account Control Driver ('none', 'ldap', 'entra_id')
NETWATCH_IDP_CONFIGURED=false
NETWATCH_IAM_DRIVER=none

# Optional Webhook Notification URL
NETWATCH_SOAR_WEBHOOK_URL=
